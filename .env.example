# Copy to .env.local and fill in. See README.md for what each one is for.

# Edamam Recipe Search API v2 — https://developer.edamam.com/
EDAMAM_APP_ID=
EDAMAM_API_KEY=

# Local Supabase, from `npx supabase status` after `npm run db:start`.
# The app reads the NEXT_PUBLIC_ pair; the seeder reads the other three
# (the service-role key is how it creates the demo users).
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local only: shows a "Sign in as demo" button in the sign-in modal and
# enables the /api/test/login route behind it. Never set this in
# production — the app refuses to honour it there, but don't rely on that.
ALLOW_TEST_LOGIN=true

# Google sign-in (Google Cloud → Credentials → OAuth client, Web application).
# Leave both empty to hide the Google option. Setup notes: src/components/GoogleSignInButton.tsx
# `npm run db:start` passes the client id to the local auth server too.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-only, for the code→token exchange in /api/auth/google. Never NEXT_PUBLIC_.
GOOGLE_CLIENT_SECRET=

# Production only — read by `npm run db:push`, never by the app. Set when
# the hosted project was created (Settings → Database).
# SUPABASE_DB_PASSWORD=

# Optional: protects /api/keepalive (the daily Vercel cron sends it as a bearer token)
CRON_SECRET=

# Optional: Umami analytics website id
NEXT_PUBLIC_UMAMI_ID=
